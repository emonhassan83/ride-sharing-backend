# ===============================
#  General Configuration
# ===============================
# Set to 'production' for a production environment
NODE_ENV=development

# ========================================
#  Redis Configuration
# ========================================
REDIS_HOST=redis
REDIS_PASSWORD=myStrongRedisPassword
REDIS_PORT=6379


# ===============================
#  Email Configuration (SMTP - Hostinger)
# ===============================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=info@splitride.com.cy
SMTP_PASSWORD=YOUR_HOSTINGER_MAILBOX_PASSWORD
EMAIL_FROM=info@splitride.com.cy

# ===============================
#  AWS S3 Credential
# ===============================

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET_NAME=

