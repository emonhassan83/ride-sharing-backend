FROM node:20-alpine

WORKDIR /app

# tzdata only; the zone itself comes from TIME_ZONE in .env at runtime.
RUN apk add --no-cache tzdata dumb-init

COPY package*.json ./
COPY tsconfig.json ./
COPY nodemon.json ./
COPY src ./src

RUN npm install

ENV NODE_ENV=development

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["npm", "run", "dev"]
